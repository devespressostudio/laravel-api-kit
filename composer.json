{
    "name": "devespresso/laravel-api-kit",
    "description": "A Laravel API kit providing filtering, transformation, repositories, request validation, and authorisation.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Abi",
            "email": "abi@devespresso.co.uk"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Devespresso\\LaravelApiKit\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devespresso\\LaravelApiKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devespresso\\LaravelApiKit\\LaravelApiKitServiceProvider"
            ]
        }
    }
}